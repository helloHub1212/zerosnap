[Unit]
Description=Native camera UI (framebuffer, no X)
# Start as early as the root filesystem is writable instead of waiting for
# basic.target.  The daemon's Python import (numpy + picamera2) costs 10-25 s
# on a Pi Zero, so every second the unit starts earlier is a second off the
# time to the first live frame.  start-camera.sh starts the daemon first and
# only then waits for /dev/fb1, so the panel appearing a few seconds later is
# harmless.
DefaultDependencies=no
After=systemd-remount-fs.service
# Conflicts= + After= makes "return to camera" wait for LightDM to release
# /dev/fb1 before the UI opens it.
After=lightdm.service
Conflicts=lightdm.service getty@tty1.service shutdown.target
Before=getty@tty1.service shutdown.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/opt/zerosnap/start-camera.sh
Restart=on-failure
RestartSec=2
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardOutput=tty
StandardError=tty
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
